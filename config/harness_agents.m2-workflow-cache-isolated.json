    "core_m2_document_no_cache": {
      "working_directory": "..",
      "case_root": "../cases/document-cache-comparison",
      "max_case_usd": 0.5,
      "command": [
        "{agent_dir}/.venv/Scripts/python.exe",
        "-m",
        "pipeline.workflow",
        "--record",
        "{record}",
        "--case-dir",
        "{case_dir}",
        "--relay-url",
        "{relay_url}",
        "--config",
        "{agent_dir}/config/brain.m2-no-cache.toml",
